library(tidyverse)
library(dplyr)
library(tidyr)
library(gridExtra)
library(ggplot2)
library(factoextra)
library(glmnet)
library(rsvd)
library(ggpubr)
library(matrixcalc)
library(grid)
library(gridtext)



setwd(dirname(rstudioapi::getSourceEditorContext()$path))
dirP<-"Sep1_2023/"
fname<-c("SupFTSVD3_DSCN1_3.csv",
         "SupFTSVD5_DSCN1_3.csv",
         "SupFTSVD8_DSCN1_3.csv")

res1 <-read.csv(paste(dirP,fname[1],sep = ""))
res2 <-read.csv(paste(dirP,fname[2],sep = ""))
res3 <-read.csv(paste(dirP,fname[3],sep = ""))

tab_all <- res1 %>%
  add_case(res2) %>%
  add_case(res3) %>%
  mutate(Samplesize=as.factor(paste0("n=", n,"\nm=", Grid)))
tab_all$Samplesize <- factor(tab_all$Samplesize, levels=levels(tab_all$Samplesize)[c(4:6,1:3)])

tab_R2 <- tab_all %>%
  select("Cov2R","SupCov2R","Sig2E","Tau","Samplesize") %>%
  pivot_longer(cols = c("Cov2R","SupCov2R"),
               names_to = "Method",
               values_to = "Vgamma") %>%
  mutate(Method=recode(Method,
                       "Cov2R"="TEMPTED",
                       "SupCov2R"="supTEMPTED"))


p_R2 <- ggplot(aes(x=as.factor(Samplesize), y=Vgamma,color=Method), data=tab_R2) +
  geom_boxplot() +
  facet_grid(Tau~Sig2E, scales = "free_y",
             labeller = label_bquote(cols = Var(e)==.(Sig2E), rows = Var(epsilon)==.(Tau))) +
  labs(x=NULL, y=expression(R^2~" of"~" Subject"~" Loading")) +
  theme_bw() +
  theme(legend.position = "top")
p_R2

lgd <- get_legend(p_R2)

p_R2 <- p_R2 + theme(legend.position = "none")




