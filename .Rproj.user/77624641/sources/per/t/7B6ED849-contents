bottom <- richtext_grob(
  text = '<span style="color:black">Number of Subjects n and Time Points m</span>'
)


lay <- rbind(rep(5,2),
             c(1,2),c(1,2),c(1,2),c(1,2),c(1,2),c(1,2),
             c(3,4),c(3,4),c(3,4),c(3,4),c(3,4),c(3,4))

pdf("../figures/supTEMPTED.pdf", width=15, height=6)
grid.arrange(p_R2 + theme(plot.margin=unit(c(0.1,0.1,-0.7,0.4), "cm")),
